{
  "name": "erdmannfreunde/lasr-theme-bundle",
  "type": "contao-bundle",
  "description": "Install LASR Theme dependencies via Contao Manager or Composer",
  "keywords": [
    "contao theme",
    "contao",
    "theme",
    "lasr",
    "laser"
  ],
  "homepage": "https://erdmann-freunde.de/contao-themes/lasr",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Dennis Erdmann",
      "homepage": "https://erdmann-freunde.de"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.7",
    "contao/manager-plugin": "^2.0",
    "symfony/http-kernel": "^6.0 || ^7.0",
    "nutshell-framework/nutshell": "^2.0",
    "nutshell-framework/hero-element": "^1.0",
    "nutshell-framework/card-element": "^1.0",
    "nutshell-framework/contact-element": "^1.0",
    "erdmannfreunde/contao-grid-bundle": "^2.0",
    "erdmannfreunde/portfoliobundle": "^5.0",
    "erdmannfreunde/theme-toolbox": "4.x-dev as 4.0.0",
    "erdmannfreunde/contao-ping-bundle": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ErdmannFreunde\\LasrThemeBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "ErdmannFreunde\\LasrThemeBundle\\ContaoManager\\Plugin"
  }
}
